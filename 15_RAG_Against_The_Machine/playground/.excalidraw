      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Intersection:\ns, e = max(c1.s, c2.s), min(c1.e, c2.e)\nI-Range = e-s",
      "autoResize": true,
      "lineHeight": 1.25
    },
